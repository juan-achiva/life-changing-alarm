{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "out-morning-ai",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-20",
  "observability": {
    "enabled": true
  },
  "vars": {
    "FIREBASE_PROJECT_ID": "life-changing-alarm-juan"
  },
  "r2_buckets": [
    {
      "binding": "OUT_PHOTOS",
      "bucket_name": "out-morning-photos"
    }
  ]
}
