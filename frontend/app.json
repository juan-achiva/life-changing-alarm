{
  "expo": {
    "name": "알람으로 인생바꾸기",
    "slug": "life-changing-alarm",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "lifechangingalarm",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "extra": {
      "router": {}
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.juanachiva.lifechangingalarm",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.juanachiva.lifechangingalarm",
      "versionCode": 1,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "게시글 사진 촬영을 위해 카메라 접근 권한이 필요합니다."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "게시글 사진 첨부를 위해 카메라 접근 권한이 필요합니다.",
          "photosPermission": "게시글 사진 첨부를 위해 사진첩 접근 권한이 필요합니다."
        }
      ],
      "expo-notifications",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 340,
          "resizeMode": "contain",
          "backgroundColor": "#F7E8EB",
          "dark": {
            "backgroundColor": "#F7E8EB"
          }
        }
      ],
      "expo-web-browser",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
