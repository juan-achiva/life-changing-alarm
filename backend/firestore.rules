rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userPath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function myGroupId() { return exists(userPath()) ? get(userPath()).data.groupId : null; }
    match /users/{userId} {
      allow create, read, update, delete: if signedIn() && request.auth.uid == userId;
    }

    match /groups/{groupId} {
      allow create: if signedIn()
        && request.resource.data.ownerUserId == request.auth.uid
        && request.resource.data.memberCount == 1
        && request.resource.data.memberUserIds == [request.auth.uid]
        && request.resource.data.maxMembers == 7;

      // Temporary compatibility with the previous shipped client.
      allow read: if signedIn();

      allow update: if signedIn()
        && (myGroupId() == groupId || myGroupId() == null)
        && request.resource.data.inviteCode == resource.data.inviteCode
        && request.resource.data.maxMembers == resource.data.maxMembers
        && request.resource.data.memberUserIds.size() == request.resource.data.memberCount
        && request.resource.data.memberProfiles.size() == request.resource.data.memberCount
        && request.resource.data.memberNames.size() == request.resource.data.memberCount
        && request.resource.data.memberUserIds.hasAny([request.resource.data.ownerUserId])
        && request.resource.data.memberCount >= 0
        && request.resource.data.memberCount <= resource.data.maxMembers
        && (
          request.resource.data.ownerUserId == resource.data.ownerUserId
          || (
            resource.data.ownerUserId == request.auth.uid
            && request.resource.data.ownerUserId != request.auth.uid
            && request.resource.data.memberCount == resource.data.memberCount - 1
            && request.resource.data.memberCount > 0
          )
        );

      allow delete: if signedIn() && resource.data.ownerUserId == request.auth.uid;

      match /posts/{postId} {
        allow read: if signedIn() && myGroupId() == groupId;
        allow create: if signedIn() && myGroupId() == groupId
          && request.resource.data.groupId == groupId
          && request.resource.data.authorUserId == request.auth.uid;
        allow update, delete: if signedIn() && resource.data.authorUserId == request.auth.uid;
      }
    }

    match /reports/{reportId} {
      allow create: if signedIn() && request.resource.data.reporterUserId == request.auth.uid;
      allow read, update, delete: if false;
    }
  }
}
